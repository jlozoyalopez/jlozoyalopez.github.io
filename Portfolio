<!-- styles.css -->
/* B — Modern Purple/Blue Theme */
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
  color: #1f2937;
}
.header {
  background: #4f46e5;
  padding: 15px 40px;
  color: white;
}
.nav-links {
  list-style: none;
  display: flex;
  gap: 20px;
}
.nav-links a {
  color: white;
  text-decoration: none;
  font-weight: bold;
}
.hero {
  text-align: center;
  padding: 80px 20px;
}
.hero h1 {
  font-size: 3rem;
  margin-bottom: 10px;
  color: #4338ca;
}
.buttons .btn {
  display: inline-block;
  padding: 10px 20px;
  margin: 10px;
  background: #6366f1;
  color: #fff;
  border-radius: 8px;
  text-decoration: none;
  font-weight: bold;
}
.content {
  max-width: 800px;
  margin: auto;
  padding: 40px 20px;
}
.project-card {
  background: white;
  padding: 20px;
  border-radius: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  margin-bottom: 20px;
}
.project-card .btn {
  background: #4f46e5;
  color: white;
  padding: 8px 15px;
  text-decoration: none;
  border-radius: 6px;
  display: inline-block;
  margin-top: 10px;
}
